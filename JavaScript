const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

// Configurações do Carro
const car = {
    x: 100,
    y: 200,
    vx: 0,
    vy: 0,
    radius: 15,
    speed: 0.15,
    friction: 0.98,
    gravity: 0.3
};

// Controles
const keys = { ArrowRight: false, ArrowLeft: false };

window.addEventListener("keydown", (e) => { if (e.key in keys) keys[e.key] = true; });
window.addEventListener("keyup", (e) => { if (e.key in keys) keys[e.key] = false; });

// Função que gera as colinas/montanhas (Terreno)
function getTerrainHeight(x) {
    // Usa ondas matemáticas para criar subidas e descidas infinitas
    return canvas.height - 100 + Math.sin(x * 0.005) * 50 + Math.sin(x * 0.01) * 20;
}

// Loop Principal do Jogo
function update() {
    // 1. Aplicar comandos do jogador
    if (keys.ArrowRight) car.vx += car.speed;
    if (keys.ArrowLeft) car.vx -= car.speed;

    // 2. Aplicar Física física básica
    car.vx *= car.friction;
    car.vy += car.gravity;

    car.x += car.vx;
    car.y += car.vy;

    // 3. Colisão com o terreno montanhoso
    const terrainY = getTerrainHeight(car.x);
    if (car.y + car.radius >= terrainY) {
        car.y = terrainY - car.radius;
        car.vy = 0; // Para de cair ao tocar o chão
    }

    // Limpar a tela para redesenhar
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Câmera segurando o carro no centro da tela (Efeito de rolagem lateral)
    ctx.save();
    ctx.translate(-car.x + 150, 0);

    // 4. Desenhar o Terreno (Terra e Grama)
    ctx.beginPath();
    ctx.fillStyle = "#8B5A2B"; // Terra
    for (let x = car.x - 200; x < car.x + 700; x++) {
        let ty = getTerrainHeight(x);
        if (x === car.x - 200) ctx.moveTo(x, canvas.height);
        ctx.lineTo(x, ty);
    }
    ctx.lineTo(car.x + 700, canvas.height);
    ctx.fill();

    // Desenhar a linha da grama (verde)
    ctx.beginPath();
    ctx.strokeStyle = "#2E8B57"; // Grama
    ctx.lineWidth = 5;
    for (let x = car.x - 200; x < car.x + 700; x++) {
        let ty = getTerrainHeight(x);
        if (x === car.x - 200) ctx.moveTo(x, ty);
        ctx.lineTo(x, ty);
    }
    ctx.stroke();

    // 5. Desenhar o Carro (Corpo)
    ctx.fillStyle = "#FF3333"; // Carro Vermelho
    ctx.fillRect(car.x - 20, car.y - 15, 40, 15);
    ctx.fillStyle = "#3399FF"; // Vidro
    ctx.fillRect(car.x, car.y - 25, 15, 10);

    // Desenhar as Rodas
    ctx.fillStyle = "#000";
    ctx.beginPath(); // Roda Traseira
    ctx.arc(car.x - 12, car.y, 8, 0, Math.PI * 2);
    ctx.fill();
    
    ctx.beginPath(); // Roda Dianteira
    ctx.arc(car.x + 12, car.y, 8, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();

    requestAnimationFrame(update);
}

// Iniciar o jogo
update();
